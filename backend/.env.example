# Copy to .env and fill in your own key. Never commit the real .env file.
# Without this set, POST /observations/{id}/annotate returns 503 and the
# frontend falls back to its own canned delta description -- see
# app/llm.py and frontend/src/RibbonScrubber.tsx.
ANTHROPIC_API_KEY=

# Optional: defaults to a small, fast model since this is a short per-point
# explanation, not a long-form generation.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Without VITALINE_API_KEY set, every endpoint is open to anyone who can
# reach this server -- including uploading PDFs and triggering billed
# Anthropic calls. Set the SAME value here and as VITE_API_KEY in
# frontend/.env.local.
VITALINE_API_KEY=

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5185

# Defaults to a local SQLite file, unencrypted at rest. Point at Postgres
# for anything beyond solo local use.
DATABASE_URL=
