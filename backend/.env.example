# Copy to .env and fill in your own key. Never commit the real .env file.
# Without this set, POST /observations/{id}/annotate returns 503 and the
# frontend falls back to its own canned delta description -- see
# app/llm.py and frontend/src/RibbonScrubber.tsx.
ANTHROPIC_API_KEY=

# Optional: defaults to a small, fast model since this is a short per-point
# explanation, not a long-form generation.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
